---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { profileData, db, strings, media, safeUrl } from "@/lib/content";
import type { SocialLink } from "@prisma/client";

const profile = await profileData();
let projects: any[] = [];
try {
  projects = await db().project.findMany({
    where: { published: true, featured: true },
    orderBy: { sortOrder: "asc" },
    take: 4,
  });
} catch {}

let links: SocialLink[] = [];
try {
  links = await db().socialLink.findMany({ orderBy: { sortOrder: "asc" } });
} catch {}
const socialLinks = links.flatMap((link) => {
  const url = safeUrl(link.url);
  return url ? [{ platform: link.platform, url }] : [];
});

const name = profile?.name || "Muhammad Rayhan Faridh";
const ogImage = profile?.ogImageKey ? media(profile.ogImageKey) : undefined;
---

<PublicLayout
  title={name}
  description={profile?.description || undefined}
  image={ogImage}
>
  <section class="hero" id="beranda">
    <div>
      <h1>{name}</h1>
      <div class="flex flex-wrap gap-4 mt-8">
        <a class="button" href="/#proyek">
          Lihat proyek ↘
        </a>
        <a class="button bg-cream" href="/#kontak">
          Mulai percakapan
        </a>
      </div>
    </div>
    <img
      class="hero-illustration"
      src="/hero-illustration.svg"
      alt=""
      width="942"
      height="704"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <section class="section split" id="tentang" aria-labelledby="tentang-title">
    <div>
      <p class="eyebrow">Sekilas tentang saya</p>
      <h2 id="tentang-title">
        Karya yang baik
        <br />
        tetap bermanfaat.
      </h2>
    </div>
    <div class="panel">
      <dl class="profile-summary">
        <div><dt>Lokasi</dt><dd>{profile?.location || "—"}</dd></div>
        <div><dt>Peran saat ini</dt><dd>{profile?.currentRole || "—"}</dd></div>
      </dl>
      <a class="button" href="/about">Selengkapnya tentang saya ↗</a>
    </div>
  </section>

  <section class="section" id="proyek" aria-labelledby="proyek-title">
    <div class="section-head">
      <h2 id="proyek-title">
        Karya
        <br />
        pilihan
      </h2>
      <a class="button" href="/projects">
        Lihat semua ↗
      </a>
    </div>
    <div class="grid">
      {projects.length
        ? projects.map((project: any) => (
            <article class="card">
              <div class="thumb">
                {project.thumbnailKey ? (
                  <img
                    src={media(project.thumbnailKey)}
                    alt={`${project.title} pratinjau proyek`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  `0${project.year || ""}`
                )}
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {strings(project.techStack).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </article>
          ))
        : ["Sistem antarmuka", "Perangkat kampanye", "Aplikasi kecil yang bermanfaat"].map(
            (title, index) => (
              <article class="card">
                <div class="thumb">0{index + 1}</div>
                <h3>{title}</h3>
                <p>Proyek akan ditampilkan di sini setelah ditambahkan.</p>
                <span class="tag">Proyek segera hadir</span>
              </article>
            ),
          )}
    </div>
  </section>

  <section class="section split" id="kontak" aria-labelledby="kontak-title">
    <div>
      <p class="eyebrow">Mari mulai percakapan</p>
      <h2 id="kontak-title">
        Mari wujudkan
        <br />
        ide Anda.
      </h2>
    </div>
    <div class="panel">
      <p class="hero-copy">
        Punya proyek, pertanyaan, atau ide menarik? Kirimkan pesan Anda.
      </p>
      <a class="button contact-button" href="/contact">
        Kirim pesan ↗
      </a>
      {socialLinks.length > 0 && (
        <div class="social-links">
          <h3>Temukan saya juga</h3>
          <div class="tags">
            {socialLinks.map((link) => (
              <a class="button" href={link.url} rel="noopener noreferrer">
                {link.platform} ↗
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</PublicLayout>
