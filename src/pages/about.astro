---
import { MapPin, GraduationCap, BriefcaseBusiness, Gamepad2 } from "lucide-react";
import { certificationKind } from "@/lib/labels";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { profileData, db, media } from "@/lib/content";
import type { Education } from "@prisma/client";
const profile = await profileData();
let educations: Education[] = [];
try {
  educations = await db().education.findMany({
    orderBy: [{ sortOrder: "asc" }, { id: "asc" }],
  });
} catch {}
let categories: any[] = [],
  experiences: any[] = [],
  certs: any[] = [];
try {
  [categories, experiences, certs] = await Promise.all([
    db().skillCategory.findMany({
      include: { skills: { orderBy: { sortOrder: "asc" } } },
      orderBy: { sortOrder: "asc" },
    }),
    db().experience.findMany({ orderBy: { sortOrder: "asc" } }),
    db().certification.findMany({ orderBy: { sortOrder: "asc" } }),
  ]);
} catch {}
---

<PublicLayout title="Tentang">
  <section class="hero">
    <div>
      <p class="eyebrow">Sosok di balik karya</p>
      <h1>
        Tentang
        <br />
        saya.
      </h1>
    </div>
    <dl class="panel orange quick-bio">
      <div class="bio-row">
        <dt>
          <span aria-hidden="true"><MapPin size={20} /></span>Lokasi:
        </dt>{" "}
        <dd>{profile?.location || "—"}</dd>
      </div>
      <div class="bio-row">
        <dt>
          <span aria-hidden="true"><GraduationCap size={20} /></span>Pendidikan:
        </dt>{" "}
        <dd>{profile?.education || "—"}</dd>
      </div>
      <div class="bio-row">
        <dt>
          <span aria-hidden="true"><BriefcaseBusiness size={20} /></span>Peran saat ini:
        </dt>{" "}
        <dd>{profile?.currentRole || "—"}</dd>
      </div>
      <div class="bio-row">
        <dt>
          <span aria-hidden="true"><Gamepad2 size={20} /></span>Hobi:
        </dt>{" "}
        <dd>{profile?.hobbies || "—"}</dd>
      </div>
    </dl>
  </section>
  {educations.length > 0 && (
    <section class="section" aria-labelledby="education-title">
      <h2 id="education-title">Pendidikan</h2>
      <ol class="education-timeline">
        {educations.map((item) => (
          <li class="education-entry">
            <article class="panel education-card">
              {item.logoKey ? (
                <img
                  src={media(item.logoKey)}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                />
              ) : (
                <svg
                  class="education-icon"
                  width="56"
                  height="56"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m2 9 10-5 10 5-10 5L2 9Z" />
                  <path d="M6 11v6c4 3 8 3 12 0v-6M22 9v7" />
                </svg>
              )}
              <div>
                <h3>{item.title}</h3>
                <p class="education-institution">{item.institution}</p>
                <p class="education-period">{item.startYear === item.endYear ? item.startYear : `${item.startYear}�${item.endYear ?? "Sekarang"}`}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>
  )}
  <section class="section">
    <div class="section-head">
      <h2>Keahlian</h2>
    </div>
    <div class="grid">
      {categories.map((category: any) => (
        <article class="card">
          <h3>{category.name}</h3>
          <div class="tags">
            {category.skills.map((skill: any) => (
              <span class="tag">{skill.name}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <h2>Pengalaman</h2>
    <div class="grid gap-4 mt-8">
      {experiences.map((item: any) => (
        <article class="panel">
          <p class="eyebrow">
            {item.startDate} — {item.endDate || "Sekarang"}
          </p>
          <h3>
            {item.title} / {item.organization}
          </h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <h2>Penghargaan</h2>
    <div class="grid mt-8">
      {certs.map((item: any) => (
        <article class="card">
          <span class="tag">{certificationKind(item.kind)}</span>
          <h3>{item.title}</h3>
          <p>
            {item.issuer} · {item.year}
          </p>
        </article>
      ))}
    </div>
  </section>
</PublicLayout>
