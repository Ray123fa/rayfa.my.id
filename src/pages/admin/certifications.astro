---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminCrud from "@/components/AdminCrud.astro";
import { list } from "@/components/adminData";
const rows = await list("certification", { sortOrder: "asc" });
---

<AdminLayout title="Sertifikasi">
  <AdminCrud
    resource="certifications"
    title="Sertifikasi"
    fields={[
      {
        name: "kind",
        type: "select",
        options: [{ value: "competition", label: "Kompetisi" }, { value: "certification", label: "Sertifikasi" }],
        required: true,
      },
      { name: "title", required: true },
      { name: "issuer", required: true },
      { name: "year", type: "number", required: true },
      { name: "sortOrder", type: "number", required: true },
    ]}
    columns={["kind", "title", "issuer", "year"]}
    rows={rows}
  />
</AdminLayout>
