---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminCrud from "@/components/AdminCrud.astro";
import { list } from "@/lib/adminData";
const categories = await list("skillCategory", { sortOrder: "asc" });
const skills = (await list("skill", { sortOrder: "asc" }))
  .map((skill) => {
    const category = categories.find((c) => c.id === skill.categoryId);
    return {
      ...skill,
      categoryName: category?.name || "—",
      categorySortOrder: category?.sortOrder ?? 999,
    };
  })
  .sort((a, b) => a.categorySortOrder - b.categorySortOrder || a.sortOrder - b.sortOrder);
---

<AdminLayout title="Keahlian">
  <AdminCrud
    resource="categories"
    title="Kategori"
    fields={[
      { name: "name", required: true },
      { name: "sortOrder", type: "number", required: true },
    ]}
    columns={["name", "sortOrder"]}
    rows={categories}
  />
  <div class="h-16"></div>
  <AdminCrud
    resource="skills"
    title="Keahlian"
    fields={[
      { name: "name", required: true },
      {
        name: "categoryId",
        type: "select",
        options: categories.map((category) => ({
          value: category.id,
          label: category.name,
        })),
        required: true,
      },
      { name: "sortOrder", type: "number", required: true },
    ]}
    columns={["name", "categoryName", "sortOrder"]}
    rows={skills}
    filter={{
      name: "categoryId",
      label: "Semua kategori",
      options: categories.map((category) => ({
        value: category.id,
        label: category.name,
      })),
    }}
  />
</AdminLayout>
