---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { list } from "@/lib/adminData";
const rows = await list("adminEmail", { createdAt: "asc" });
---

<AdminLayout title="Akses">
  <h1>Daftar akses admin</h1>
  <form class="panel my-8" data-access>
    <label>
      <span>Email <span class="required-mark">*</span></span>
      <input
        name="email"
        type="email"
        required
        maxlength="254"
        placeholder="admin@example.com"
      />
    </label>
    <button class="mt-4">Tambah email ↗</button>
    <p role="status"></p>
  </form>
  <table class="data-table">
    <thead>
      <tr>
        <th>Email</th>
        <th>Jenis</th>
        <th>Ditambahkan</th>
        <th>Tindakan</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.email}</td>
          <td>{row.isDefault ? "Bawaan" : "Ditambahkan"}</td>
          <td>{new Date(row.createdAt).toLocaleDateString("id-ID")}</td>
          <td>
            {!row.isDefault && rows.length > 1 && (
              <button type="button" data-remove={row.id}>
                Hapus
              </button>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <script>
    import { setupFormValidation } from "@/lib/adminFormValidation";
    import { adminRequest, deleteResource, getErrorMessage } from "@/lib/client/adminApi";
    const form = document.querySelector<HTMLFormElement>("[data-access]")!;
    const validation = setupFormValidation(form);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validation.validate()) return;
      const response = await adminRequest("/api/admin/access", {
        method: "POST",
        body: JSON.stringify({ email: new FormData(form).get("email") }),
      });
      if (response.ok) {
        location.href = "/admin/access?status=berhasil&action=tambah";
      } else {
        alert(await getErrorMessage(response, "Gagal menambahkan email."));
      }
    });
    document.querySelectorAll<HTMLElement>("[data-remove]").forEach((button) =>
      button.addEventListener("click", () =>
        deleteResource(
          `/api/admin/access/${button.dataset.remove}`,
          "Hapus email admin ini? Sesi yang aktif akan kehilangan akses.",
        )
      ),
    );
  </script>
</AdminLayout>
