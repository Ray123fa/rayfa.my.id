---
import { fieldLabel } from "@/lib/labels";
import AdminLayout from "@/layouts/AdminLayout.astro";
import ImageDropzone from "@/components/ImageDropzone.astro";
import { profileData } from "@/components/content";
const profile = await profileData();
const value = (field: string) =>
  String(profile?.[field as keyof typeof profile] || "");
---

<AdminLayout title="Profil">
  <h1>Profil</h1>
  <form class="panel form-grid" data-profile>
    {[
      "name",
      "description",
      "location",
      "education",
      "currentRole",
      "hobbies",
    ].map((field) => (
      <label>
        <span>
          {fieldLabel(field).toUpperCase()}
          {["name", "description"].includes(field) ? (
            <span class="required-mark"> *</span>
          ) : (
            <span class="field-note"> (opsional)</span>
          )}
        </span>
        {field === "description" ? (
          <textarea
            name={field}
            required
            placeholder="Perkenalan singkat untuk portofolio Anda"
          >{value(field)}</textarea>
        ) : (
          <input
            name={field}
            value={value(field)}
            required={field === "name"}
            placeholder={`Masukkan ${fieldLabel(field).toLowerCase()}`}
          />
        )}
      </label>
    ))}
    <div data-profile-upload data-image-key={profile?.ogImageKey || ""}>
      <ImageDropzone name="ogImage" label="Gambar pratinjau tautan" idPrefix="profile" />
    </div>
    <button class="wide">Simpan profil ↗</button>
    <p class="wide" role="status"></p>
  </form>
  <script>
    import { setupFormValidation } from "@/lib/adminFormValidation";
    import { setupImageUpload } from "@/lib/imageUpload";
    const csrf = () =>
      document.cookie
        .split("; ")
        .find((v) => v.startsWith("__Host-portoku_csrf="))
        ?.split("=")
        .slice(1)
        .join("=") || "";
    const form = document.querySelector<HTMLFormElement>("[data-profile]")!;
    const validation = setupFormValidation(form);
    const uploads = Array.from(
      form.querySelectorAll<HTMLElement>("[data-profile-upload]"),
    ).map((root) => setupImageUpload(root, root.dataset.imageKey || null));
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validation.validate()) return;
      const files = new FormData(form);
      const data: Record<string, unknown> = {};
      for (const [key, value] of files) {
        if (value instanceof File) {
          if (!value.size) continue;
          const upload = new FormData();
          upload.set("file", value);
          const result = await fetch("/api/admin/upload", {
            method: "POST",
            headers: { "x-csrf-token": csrf() },
            body: upload,
          });
          if (!result.ok) {
            form.querySelector("[role=status]")!.textContent =
              "Gagal mengunggah gambar.";
            return;
          }
          data.ogImageKey = (
            (await result.json()) as { key: string }
          ).key;
        } else data[key] = value;
      }
      ["ogImageKey"].forEach((key, index) => {
        const upload = uploads[index];
        if (upload.removed && !(key in data)) data[key] = null;
        else if (upload.key) data[key] ??= upload.key;
      });
      const result = await fetch("/api/admin/profile", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrf() },
        body: JSON.stringify(data),
      });
      form.querySelector("[role=status]")!.textContent = result.ok
        ? "Tersimpan. Memuat ulang…"
        : "Gagal menyimpan profil.";
      if (result.ok) location.reload();
    });
  </script>
</AdminLayout>

<style>
  .required-mark {
    color: #b42318;
  }
  .field-note {
    color: var(--muted-foreground);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
  }
</style>
