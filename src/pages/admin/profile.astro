---
import { fieldLabel } from "@/lib/labels";
import AdminLayout from "@/layouts/AdminLayout.astro";
import ImageDropzone from "@/components/ImageDropzone.astro";
import { profileData } from "@/lib/content";
const profile = await profileData();
const value = (field: string) =>
  String(profile?.[field as keyof typeof profile] || "");
---

<AdminLayout title="Profil">
  <h1>Profil</h1>
  <form class="panel form-grid" data-profile method="POST">
    {[
      "name",
      "description",
      "location",
      "education",
      "currentRole",
      "hobbies",
    ].map((field) => (
      <label>
        <span>
          {fieldLabel(field).toUpperCase()}
          {["name", "description"].includes(field) ? (
            <span class="required-mark"> *</span>
          ) : (
            <span class="field-note"> (opsional)</span>
          )}
        </span>
        {field === "description" ? (
          <textarea
            name={field}
            required
            placeholder="Perkenalan singkat untuk portofolio Anda"
          >{value(field)}</textarea>
        ) : (
          <input
            name={field}
            value={value(field)}
            required={field === "name"}
            placeholder={`Masukkan ${fieldLabel(field).toLowerCase()}`}
          />
        )}
      </label>
    ))}
    <div data-profile-upload data-image-key={profile?.ogImageKey || ""}>
      <ImageDropzone
        name="ogImage"
        label="Gambar pratinjau tautan"
        idPrefix="profile"
      />
    </div>
    <button class="wide">Simpan profil ↗</button>
    <p class="wide" role="status"></p>
  </form>
  <script>
    import { toast } from "@/lib/client/toast";
    import { setupFormValidation } from "@/lib/adminFormValidation";
    import { setupImageUpload } from "@/lib/imageUpload";
    import {
      adminRequest,
      uploadImage,
      getErrorMessage,
    } from "@/lib/client/adminApi";
    const form = document.querySelector<HTMLFormElement>("[data-profile]")!;
    const validation = setupFormValidation(form);
    const status = form.querySelector<HTMLElement>("[role=status]")!;
    const submit = form.querySelector<HTMLButtonElement>("button.wide")!;
    let saving = false;
    const uploads = Array.from(
      form.querySelectorAll<HTMLElement>("[data-profile-upload]"),
    ).map((root) => setupImageUpload(root, root.dataset.imageKey || null));
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (saving) return;
      if (!validation.validate()) return;
      saving = true;
      submit.disabled = true;
      status.textContent = "Menyimpan…";
      try {
        const files = new FormData(form);
        const data: Record<string, unknown> = {};
        for (const [key, value] of files) {
          if (value instanceof File) {
            if (!value.size) continue;
            data.ogImageKey = await uploadImage(value);
          } else data[key] = value;
        }
        ["ogImageKey"].forEach((key, index) => {
          const upload = uploads[index];
          if (upload.removed && !(key in data)) data[key] = null;
          else if (upload.key) data[key] ??= upload.key;
        });
        const result = await adminRequest("/api/admin/profile", {
          method: "POST",
          body: JSON.stringify(data),
        });
        if (result.ok) {
          location.href = "/admin/profile?status=berhasil&action=profile";
        } else {
          throw new Error(
            await getErrorMessage(result, "Gagal menyimpan profil."),
          );
        }
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "Gagal menyimpan profil. Silakan coba lagi.";
        status.textContent = message;
        toast.add({ type: "error", title: message });
      } finally {
        saving = false;
        submit.disabled = false;
      }
    });
  </script>
</AdminLayout>
