---
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout title="Tidak ditemukan" noindex>
  <section class="hero">
    <div>
      <p class="eyebrow">404</p>
      <h1>
        Halaman
        <br />
        tidak ditemukan.
      </h1>
    </div>
    <div class="panel orange">
      <p class="hero-copy">Halaman ini telah dipindahkan atau tidak ditemukan.</p>
      <a class="button" style="background:var(--cream)" href="/">
        Kembali ke beranda ↖
      </a>
    </div>
  </section>
</PublicLayout>
