---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { db, strings, media, safeUrl } from "@/lib/content";

const filter = Astro.url.searchParams.get("tech")?.slice(0, 40);
const requestedPage = Number(Astro.url.searchParams.get("page") || "1");
const pageSize = 9;

let projects: any[] = [];
try {
  projects = await db().project.findMany({
    where: { published: true },
    orderBy: [{ sortOrder: "asc" }, { year: "desc" }],
  });
} catch {}

const tags = [
  ...new Set(projects.flatMap((project) => strings(project.techStack))),
].sort();
const filtered = filter
  ? projects.filter((project) => strings(project.techStack).includes(filter))
  : projects;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const page = Number.isFinite(requestedPage)
  ? Math.min(Math.max(1, Math.trunc(requestedPage)), totalPages)
  : 1;
const visible = filtered.slice((page - 1) * pageSize, page * pageSize);
const href = (target: number) => {
  const params = new URLSearchParams();
  if (filter) params.set("tech", filter);
  if (target > 1) params.set("page", String(target));
  const query = params.toString();
  return `/projects${query ? `?${query}` : ""}`;
};
---

<PublicLayout title="Proyek">
  <section class="hero">
    <div>
      <p class="eyebrow">Studi kasus & eksperimen</p>
      <h1>
        Proyek
        <br />
        pilihan.
      </h1>
    </div>
    <p class="hero-copy">
      Kumpulan produk yang telah dirilis, eksperimen menarik, dan
      hasil kolaborasi.
    </p>
  </section>

  <nav class="tags my-8" aria-label="Filter proyek">
    <a class="tag" href="/projects" aria-current={!filter ? "page" : undefined}>
      Semua
    </a>
    {tags.map((tag) => (
      <a
        class="tag"
        href={`/projects?tech=${encodeURIComponent(tag)}`}
        aria-current={filter === tag ? "page" : undefined}
      >
        {tag}
      </a>
    ))}
  </nav>

  <section class="section border-t-0 pt-0">
    <div class="grid">
      {visible.map((project: any) => (
        <article class="card">
          <div class="thumb">
            {project.thumbnailKey ? (
              <img
                src={media(project.thumbnailKey)}
                alt={`${project.title} pratinjau proyek`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              project.year
            )}
          </div>
          <span class="tag self-start">
            {project.year}
          </span>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <div class="tags">
            {strings(project.techStack).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="flex gap-4 mt-auto">
            {safeUrl(project.githubUrl) && (
              <a href={safeUrl(project.githubUrl)} rel="noopener noreferrer">
                GitHub ↗
              </a>
            )}
            {safeUrl(project.demoUrl) && (
              <a href={safeUrl(project.demoUrl)} rel="noopener noreferrer">
                Lihat demo ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    {!visible.length && (
      <div class="panel">
        <h2>
          {filter
            ? `Belum ada proyek dengan tag “${filter}”.`
            : "Belum ada proyek yang dipublikasikan."}
        </h2>
        <p>
          {filter ? "Coba tag lain atau lihat semua proyek." : "Silakan kunjungi kembali nanti."}
        </p>
        {filter && (
          <a class="button" href="/projects">
            Lihat semua proyek
          </a>
        )}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="pagination" aria-label="Halaman proyek">
        {page > 1 ? (
          <a class="button" href={href(page - 1)}>
            ← Sebelumnya
          </a>
        ) : (
          <span />
        )}
        <span>
          Halaman {page} dari {totalPages}
        </span>
        {page < totalPages ? (
          <a class="button" href={href(page + 1)}>
            Berikutnya →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>
</PublicLayout>
