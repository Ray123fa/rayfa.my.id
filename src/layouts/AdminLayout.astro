---
import "../styles/globals.css";
import "../styles/components.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const sections = [
  ["Ringkasan", "/admin"],
  ["Proyek", "/admin/projects"],
  ["Profil", "/admin/profile"],
  ["Keahlian", "/admin/skills"],
  ["Pendidikan", "/admin/education"],
  ["Pengalaman", "/admin/experience"],
  ["Sertifikasi", "/admin/certifications"],
  ["Tautan sosial", "/admin/social-links"],
  ["Pesan", "/admin/messages"],
  ["Akses", "/admin/access"],
  ["Audit", "/admin/audit"],
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title} · Admin</title>
  </head>
  <body>
    <a href="#admin-content" class="skip">
      Langsung ke konten
    </a>
    <div class="admin-layout">
      <aside
        class="admin-side"
        id="admin-sidebar"
        aria-label="Panel samping admin"
      >
        <button
          type="button"
          class="sidebar-close"
          aria-label="Tutup panel samping"
          data-sidebar-close
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m6 6 12 12M6 18 18 6" />
          </svg>
        </button>
        <a class="logo" href="/admin">
          RF● / KENDALI
        </a>
        <nav aria-label="Navigasi admin">
          {sections.map(([name, path]) => (
            <a
              href={path}
              aria-current={Astro.url.pathname === path ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </nav>
        <a href="/" class="block mt-8">
          ← Situs publik
        </a>
      </aside>
      <div class="sidebar-backdrop" data-sidebar-backdrop hidden></div>
      <div class="admin-main">
        <header class="flex items-center justify-between gap-4 border-b-[3px] pb-6 mb-8">
          <button
            type="button"
            class="sidebar-toggle"
            aria-label="Tutup panel samping"
            aria-controls="admin-sidebar"
            aria-expanded="true"
            data-sidebar-toggle
            hidden
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M9 4v16" />
            </svg>
          </button>
          <strong>KELOLA KONTEN / {title.toUpperCase()}</strong>
          <form action="/api/auth/logout" method="post" id="logout-form">
            <button type="submit">Keluar ↗</button>
          </form>
        </header>
        <main id="admin-content">
          <slot />
        </main>
      </div>
    </div>
    <script>
      import { showAlert } from "@/lib/adminDialog";
      import { setupAdminSidebar } from "@/lib/adminSidebar";
      import { mountToaster } from "@/lib/client/toaster";
      import { fetchWithCsrf } from "@/lib/client/csrf";
      setupAdminSidebar();
      void mountToaster();
      document
        .querySelector<HTMLFormElement>('form[action="/api/auth/logout"]')
        ?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const response = await fetchWithCsrf("/api/auth/logout", {
            method: "POST",
          });
          if (response.ok) location.href = "/admin/login";
          else await showAlert("Gagal keluar. Silakan coba lagi.");
        });
    </script>
  </body>
</html>
