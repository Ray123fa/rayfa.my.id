---
import "../styles/globals.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const sections = [
  ["Ringkasan", "/admin"],
  ["Proyek", "/admin/projects"],
  ["Profil", "/admin/profile"],
  ["Keahlian", "/admin/skills"],
  ["Pendidikan", "/admin/education"],
  ["Pengalaman", "/admin/experience"],
  ["Sertifikasi", "/admin/certifications"],
  ["Tautan sosial", "/admin/social-links"],
  ["Pesan", "/admin/messages"],
  ["Akses", "/admin/access"],
  ["Audit", "/admin/audit"],
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title} · Admin</title>
  </head>
  <body>
    <a href="#admin-content" class="skip">
      Langsung ke konten
    </a>
    <div class="admin-layout">
      <aside
        class="admin-side"
        id="admin-sidebar"
        aria-label="Panel samping admin"
      >
        <button
          type="button"
          class="sidebar-close"
          aria-label="Tutup panel samping"
          data-sidebar-close
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m6 6 12 12M6 18 18 6" />
          </svg>
        </button>
        <a class="logo" href="/admin">
          RK● / KENDALI
        </a>
        <nav aria-label="Navigasi admin">
          {sections.map(([name, path]) => (
            <a
              href={path}
              aria-current={Astro.url.pathname === path ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </nav>
        <a href="/" style="display:block;margin-top:2rem">
          ← Situs publik
        </a>
      </aside>
      <div class="sidebar-backdrop" data-sidebar-backdrop hidden></div>
      <div class="admin-main">
        <header style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:3px solid;padding-bottom:1.5rem;margin-bottom:2rem">
          <button
            type="button"
            class="sidebar-toggle"
            aria-label="Tutup panel samping"
            aria-controls="admin-sidebar"
            aria-expanded="true"
            data-sidebar-toggle
            hidden
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M9 4v16" />
            </svg>
          </button>
          <strong>KELOLA KONTEN / {title.toUpperCase()}</strong>
          <form action="/api/auth/logout" method="post" id="logout-form">
            <button type="submit">Keluar ↗</button>
          </form>
        </header>
        <main id="admin-content">
          <slot />
        </main>
      </div>
    </div>
    <script>
      import { showAlert } from "@/lib/adminDialog";
      import { setupAdminSidebar } from "@/lib/adminSidebar";
      setupAdminSidebar();
      document
        .querySelector<HTMLFormElement>('form[action="/api/auth/logout"]')
        ?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const token =
            document.cookie
              .split("; ")
              .find((value) => value.startsWith("__Host-portoku_csrf="))
              ?.split("=")
              .slice(1)
              .join("=") || "";
          const response = await fetch("/api/auth/logout", {
            method: "POST",
            headers: { "x-csrf-token": token },
          });
          if (response.ok) location.href = "/admin/login";
          else await showAlert("Gagal keluar. Silakan coba lagi.");
        });
    </script>
  </body>
</html>

<style>
  .sidebar-close {
    display: none;
  }
  .sidebar-toggle,
  .sidebar-close {
    align-items: center;
    justify-content: center;
    padding: 0.65rem;
    min-width: 44px;
    min-height: 44px;
  }
  .sidebar-toggle:not([hidden]) {
    display: inline-flex;
  }
  .admin-main > header > strong {
    flex: 1;
  }
  .admin-layout[data-sidebar-ready][data-sidebar-open="false"] {
    grid-template-columns: minmax(0, 1fr);
  }
  .admin-layout[data-sidebar-ready][data-sidebar-open="false"] > .admin-side {
    display: none;
  }
  @media (max-width: 800px) {
    .admin-layout[data-sidebar-ready] > .admin-side {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(280px, 85vw);
      height: 100dvh;
      z-index: 21;
      border-right: 3px solid var(--ink);
      border-bottom: 0;
      animation: sidebar-enter 180ms ease-out;
    }
    .admin-layout[data-sidebar-ready] .admin-side nav {
      grid-template-columns: 1fr;
    }
    .admin-layout[data-sidebar-ready] .sidebar-close {
      display: inline-flex;
      align-self: flex-end;
      margin-bottom: 0.5rem;
    }
    .sidebar-backdrop:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: var(--overlay);
    }
  }
  @keyframes sidebar-enter {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .admin-layout[data-sidebar-ready] > .admin-side {
      animation: none;
    }
  }
</style>
