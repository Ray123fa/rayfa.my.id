---
import { fieldLabel, certificationKind } from "@/lib/labels";
import AdminField, { type Field } from "@/components/AdminField.astro";
import ImageDropzone from "@/components/ImageDropzone.astro";
interface Props {
  resource: string;
  title: string;
  fields: Field[];
  rows?: Record<string, any>[];
  columns?: string[];
  uploadField?: string;
  filter?: {
    name: string;
    label: string;
    options: { value: string; label: string }[];
  };
}
const {
  resource,
  title,
  fields,
  rows = [],
  columns = fields.map((f) => f.name).slice(0, 4),
  uploadField,
  filter,
} = Astro.props;

const allRows = JSON.stringify(rows);

// Consecutive fields marked inline:true share a single row, e.g. number + checkboxes.
const groups = fields.reduce<Array<{ inline: boolean; items: Field[] }>>(
  (groups, field) => {
    const last = groups[groups.length - 1];
    if (field.inline && last?.inline) last.items.push(field);
    else groups.push({ inline: Boolean(field.inline), items: [field] });
    return groups;
  },
  [],
);
---

<section
  data-crud={resource}
  data-upload-field={uploadField || ""}
  data-all-rows={allRows}
>
  <div class="section-head">
    <div>
      <p class="eyebrow">Modul admin</p>
      <h1>{title}</h1>
    </div>
    <div class="flex gap-4 items-center">
      {filter && (
        <label>
          <span class="sr-only">{filter.label}</span>
          <select data-filter={filter.name} class="min-w-[180px]">
            <option value="">{filter.label}</option>
            {filter.options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      )}
      <button type="button" data-new class="shrink-0">
        Tambah data
      </button>
    </div>
  </div>

  <dialog
    class="panel"
    data-editor
    aria-labelledby={`${resource}-editor-title`}
  >
    <form method="dialog" class="form-grid" data-form novalidate>
      <h2 class="wide" id={`${resource}-editor-title`} data-editor-title>
        Tambah {title}
      </h2>
      <input type="hidden" name="id" />
      {groups.map((group) =>
        group.inline ? (
          <div class="inline-row">
            {group.items.map((field) => (
              <AdminField field={field} idPrefix={resource} />
            ))}
          </div>
        ) : (
          group.items.map((field) => (
            <AdminField field={field} idPrefix={resource} />
          ))
        ),
      )}
      {uploadField && (
        <ImageDropzone name="image" label="Gambar" idPrefix={resource} />
      )}
      <p class="wide" role="status"></p>
      <div class="wide flex gap-4">
        <button type="submit">Simpan ↗</button>
        <button type="button" data-close class="bg-cream!">
          Batal
        </button>
      </div>
    </form>
  </dialog>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          {columns.map((col) => (
            <th>{fieldLabel(col)}</th>
          ))}
          <th>Tindakan</th>
        </tr>
      </thead>
      <tbody data-table-body>
        {rows.map((row, idx) => (
          <tr data-row>
            {columns.map((col) => (
              <td>
                {col === "kind"
                  ? certificationKind(String(row[col] ?? ""))
                  : typeof row[col] === "boolean"
                    ? row[col]
                      ? "Ya"
                      : "Tidak"
                    : Array.isArray(row[col])
                      ? row[col].join(", ")
                      : String(row[col] ?? "—")}
              </td>
            ))}
            <td>
              <button type="button" data-edit data-row-index={idx}>
                Ubah
              </button>
              <button type="button" data-delete={row.id} class="bg-cream!">
                Hapus
              </button>
            </td>
          </tr>
        ))}
        {!rows.length && (
          <tr data-empty>
            <td colspan={columns.length + 1}>
              Belum ada data. Pilih "Tambah data" untuk menambahkan.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
  <div class="pagination" data-pagination hidden>
    <button type="button" data-prev disabled>
      ← Sebelumnya
    </button>
    <span data-page-info></span>
    <button type="button" data-next>
      Berikutnya →
    </button>
  </div>
</section>
<script>
  import { setupImageUpload } from "@/lib/imageUpload";
  import { setupFormValidation } from "@/lib/adminFormValidation";
  import {
    adminRequest,
    uploadImage,
    deleteResource,
    getErrorMessage,
  } from "@/lib/client/adminApi";
  const parseJsonArray = (value: unknown): string[] | null => {
    if (Array.isArray(value))
      return value.filter((item): item is string => typeof item === "string");
    if (typeof value !== "string" || !value.startsWith("[")) return null;
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed)
        ? parsed.filter((item): item is string => typeof item === "string")
        : null;
    } catch {
      return null;
    }
  };

  document.querySelectorAll<HTMLElement>("[data-crud]").forEach((root) => {
    const resource = root.dataset.crud!;
    const dialog = root.querySelector<HTMLDialogElement>("[data-editor]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const status = form.querySelector<HTMLElement>("[role=status]")!;
    const editorTitle = form.querySelector<HTMLElement>("[data-editor-title]")!;
    const validation = setupFormValidation(form);
    const submit = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    let saving = false;
    const uploadField = root.dataset.uploadField || "";
    const uploadRoot = root.querySelector<HTMLElement>("[data-image-upload]");
    const imageUpload = uploadRoot ? setupImageUpload(uploadRoot) : null;

    // chip fields store the tag list in a hidden comma-separated input;
    // the visible text input only buffers what is being typed.
    const chipSyncs: Array<() => void> = [];
    root.querySelectorAll<HTMLElement>("[data-chips]").forEach((group) => {
      const store = group.querySelector<HTMLInputElement>("input[type=hidden]");
      const buffer = group.querySelector<HTMLInputElement>(".chip-input");
      if (!store || !buffer) return;
      const values = () =>
        store.value
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean);
      const write = (list: string[]) => {
        store.value = Array.from(new Set(list)).join(", ");
        sync();
      };
      const sync = () => {
        group
          .querySelectorAll<HTMLElement>("[data-chip]")
          .forEach((chip) => chip.remove());
        for (const value of values()) {
          const chip = document.createElement("span");
          chip.className = "chip";
          chip.dataset.chip = "";
          const label = document.createElement("span");
          label.textContent = value;
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "chip-remove";
          remove.setAttribute("aria-label", `Hapus ${value}`);
          remove.textContent = "×";
          // Keep focus in the buffer so its blur/commit does not re-render the
          // chips before this button's click handler runs.
          remove.addEventListener("mousedown", (event) =>
            event.preventDefault(),
          );
          remove.addEventListener("click", () =>
            write(values().filter((item) => item !== value)),
          );
          chip.appendChild(label);
          chip.appendChild(remove);
          store.parentElement?.insertBefore(chip, store);
        }
      };
      const commit = () => {
        const additions = buffer.value
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean);
        buffer.value = "";
        if (additions.length) write([...values(), ...additions]);
        else sync();
      };
      buffer.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === ",") {
          event.preventDefault();
          commit();
        } else if (event.key === "Backspace" && !buffer.value) {
          const current = values();
          if (current.length) {
            current.pop();
            write(current);
          }
        }
      });
      buffer.addEventListener("blur", commit);
      group.addEventListener("click", (event) => {
        if (event.target === group) buffer.focus();
      });
      sync();
      chipSyncs.push(sync);
    });

    const open = (row: Record<string, unknown> = {}) => {
      editorTitle.textContent = `${row.id ? "Ubah" : "Tambah"} ${root.querySelector(".section-head h1")?.textContent || ""}`;
      form.reset();
      status.textContent = "";
      for (const [key, raw] of Object.entries(row)) {
        const control = form.elements.namedItem(key) as
          HTMLInputElement | HTMLSelectElement | null;
        if (!control) continue;
        if (control instanceof HTMLInputElement && control.type === "checkbox")
          control.checked = Boolean(raw);
        else {
          const value = parseJsonArray(raw) ?? raw;
          control.value = Array.isArray(value)
            ? value.join(", ")
            : String(value ?? "");
        }
      }
      const saved = uploadField ? row[uploadField] : undefined;
      imageUpload?.reset(typeof saved === "string" ? saved : null);
      dialog.showModal();
      chipSyncs.forEach((sync) => sync());
      form.dispatchEvent(new Event("admin:sync-selects"));
    };

    root.querySelector("[data-new]")?.addEventListener("click", () => open());
    root
      .querySelector("[data-close]")
      ?.addEventListener("click", () => dialog.close());
    root.querySelectorAll<HTMLElement>("[data-edit]").forEach((button) => {
      const allRowsData = JSON.parse(root.dataset.allRows || "[]");
      button.addEventListener("click", () => {
        const idx = Number(button.dataset.rowIndex);
        open(allRowsData[idx] || {});
      });
    });

    root
      .querySelectorAll<HTMLElement>("[data-delete]")
      .forEach((button) =>
        button.addEventListener("click", () =>
          deleteResource(
            `/api/admin/${resource}/${button.dataset.delete}`,
            "Hapus data ini? Tindakan ini tidak dapat dibatalkan.",
          ),
        ),
      );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (saving) return;
      if (!validation.validate()) return;
      saving = true;
      submit.disabled = true;
      status.textContent = "Menyimpan…";
      try {
        const formData = new FormData(form);
        const id = String(formData.get("id") || "");
        formData.delete("id");
        const image = formData.get("image");
        formData.delete("image");
        let uploaded: string | undefined;

        if (image instanceof File && image.size) {
          uploaded = await uploadImage(image);
        }

        const data: Record<string, unknown> = {};
        for (const [key, value] of formData) {
          const control = form.elements.namedItem(
            key,
          ) as HTMLInputElement | null;
          if (control?.type === "checkbox") data[key] = control.checked;
          else if (control?.type === "number")
            data[key] = value === "" ? undefined : Number(value);
          else if (control?.dataset.type === "tags")
            data[key] = String(value)
              .split(",")
              .map((item) => item.trim())
              .filter(Boolean);
          else data[key] = value === "" ? null : String(value);
        }
        // Unchecked checkboxes are omitted from FormData, so read them from the form.
        form
          .querySelectorAll<HTMLInputElement>('input[type="checkbox"][name]')
          .forEach((control) => {
            data[control.name] = control.checked;
          });
        if (uploaded && uploadField) data[uploadField] = uploaded;
        else if (imageUpload?.removed && uploadField) data[uploadField] = null;

        const response = await adminRequest(
          id ? `/api/admin/${resource}/${id}` : `/api/admin/${resource}`,
          {
            method: id ? "PUT" : "POST",
            body: JSON.stringify(data),
          },
        );
        if (response.ok) {
          location.href =
            location.pathname +
            `?status=berhasil&action=${id ? "edit" : "tambah"}`;
        } else {
          throw new Error(
            await getErrorMessage(response, "Gagal menyimpan data."),
          );
        }
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Gagal menyimpan data. Silakan coba lagi.";
      } finally {
        saving = false;
        submit.disabled = false;
      }
    });
  });

  // Pagination
  document.querySelectorAll<HTMLElement>("[data-crud]").forEach((root) => {
    const tbody = root.querySelector<HTMLElement>("[data-table-body]");
    const pagination = root.querySelector<HTMLElement>("[data-pagination]");
    const pageInfo = pagination?.querySelector<HTMLElement>("[data-page-info]");
    const prevBtn = pagination?.querySelector<HTMLButtonElement>("[data-prev]");
    const nextBtn = pagination?.querySelector<HTMLButtonElement>("[data-next]");
    const filterSelect = root.querySelector(
      "[data-filter]",
    ) as HTMLSelectElement | null;
    const emptyRow = tbody?.querySelector<HTMLElement>("[data-empty]");
    if (!tbody || !pagination || !pageInfo || !prevBtn || !nextBtn) return;

    const PER_PAGE = 15;
    let currentPage = 1;
    let filteredRows: HTMLElement[] = [];

    const allRows = () =>
      Array.from(tbody.querySelectorAll<HTMLElement>("[data-row]"));

    const applyFilter = () => {
      const filterValue = filterSelect?.value || "";
      const filterAttr = filterSelect?.dataset.filter;
      const rows = allRows();
      const allRowsData = JSON.parse(root.dataset.allRows || "[]");

      filteredRows = rows.filter((_, idx) => {
        if (!filterValue || !filterAttr) return true;
        const rowData = allRowsData[idx];
        return String(rowData[filterAttr]) === filterValue;
      });
      currentPage = 1;
      render();
    };

    const render = () => {
      const total = filteredRows.length;
      const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
      currentPage = Math.min(currentPage, totalPages);

      const start = (currentPage - 1) * PER_PAGE;
      const end = start + PER_PAGE;

      allRows().forEach((row) => (row.hidden = true));
      filteredRows.slice(start, end).forEach((row) => (row.hidden = false));

      if (emptyRow) emptyRow.hidden = total > 0;
      pagination.hidden = total <= PER_PAGE;

      pageInfo.textContent = `Halaman ${currentPage} dari ${totalPages}`;
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;
    };

    prevBtn.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        render();
      }
    });

    nextBtn.addEventListener("click", () => {
      const totalPages = Math.ceil(filteredRows.length / PER_PAGE);
      if (currentPage < totalPages) {
        currentPage++;
        render();
      }
    });

    if (filterSelect) {
      filterSelect.addEventListener("change", applyFilter);
    }

    applyFilter();
  });
</script>
