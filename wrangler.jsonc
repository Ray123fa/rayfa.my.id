{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portoku",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portoku",
			"database_id": "f32bf612-361d-49fe-b097-7be5935cc9e1",
			"migrations_dir": "prisma/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "portoku-media"
		}
	]
}